{
  /* The service worker runs in a ServiceWorkerGlobalScope, which is neither the DOM
     (tsconfig.app.json) nor the Workers runtime (tsconfig.cf.json), so it gets its own project. */
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "WebWorker"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
  },
  "include": ["src/sw.ts", "src/vite-env.d.ts"]
}
