{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig.json to read more about this file */

    /* Set the JavaScript language version for emitted JavaScript and include compatible library declarations. */
    "target": "es2021",
    /* Specify a set of bundled library declaration files that describe the target runtime environment. */
    "lib": ["es2021"],

    /* Specify what module code is generated. */
    "module": "es2022",
    /* Specify how TypeScript looks up a file from a module specifier. */
    "moduleResolution": "Bundler",
    /* Runtime types come from the generated worker-configuration.d.ts (npm run typegen);
       vitest/importMeta types the in-source `import.meta.vitest` test blocks. */
    "types": ["vitest/importMeta"],
    /* Enable importing .json files */
    "resolveJsonModule": true,

    /* Allow JavaScript files to be a part of your program. Use the `checkJS` option to get errors from these files. */
    "allowJs": true,
    /* Enable error reporting in type-checked JavaScript files. */
    "checkJs": false,

    /* This project is referenced by tsconfig.app.json so the frontend can import the Worker's
       route types (Hono RPC). Referenced projects must be composite and emit declarations;
       they go to .tsbuild/ (gitignored) and nothing else is emitted. */
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild/cf",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cf.tsbuildinfo",

    /* Ensure that each file can be safely transpiled without relying on other imports. */
    "isolatedModules": true,
    /* Allow 'import x from y' when a module doesn't have a default export. */
    "allowSyntheticDefaultImports": true,
    /* Ensure that casing is correct in imports. */
    "forceConsistentCasingInFileNames": true,

    /* Enable all strict type-checking options. */
    "strict": true,

    /* Skip type checking all .d.ts files. */
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/service.ts",
    "src/services/**/*.ts",
    "src/lib/**/*.ts"
  ]
}
