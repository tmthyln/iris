    "bulma": "^1.0.0",
    "dompurify": "^3.4.17",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "~10.0.1",
    "@types/sortablejs": "^1.15.9",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "~10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "fast-xml-parser": "^5.12.0",
    "globals": "^17.14.0",
    "hono": "^4.13.16",
    "jsdom": "^30.1.3",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
