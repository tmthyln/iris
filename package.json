{
  "name": "iris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b",
    "typegen": "wrangler types --strict-vars=false",
