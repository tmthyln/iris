{
  "name": "iris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b",
    "typegen": "wrangler types",
    "generate:assets": "pwa-assets-generator --preset minimal public/logo.svg",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "bulma": "^1.0.0",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "~10.0.1",
    "@types/sortablejs": "^1.15.9",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "~10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "fast-xml-parser": "^5.7.1",
    "globals": "^17.6.0",
    "hono": "^4.12.18",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite-plugin-inspect": "12.0.0-beta.2"
    }
  },
  "allowScripts": {
    "sharp@0.35.2": true,
    "sharp@0.33.5": true,
    "workerd@1.20260811.1": true,
    "esbuild@0.28.1": true
  }
